#!/bin/sh
# Send unauthority words or a small measured PNG drawing to a running Alien World under your chosen name.
set -eu
repo=$(CDPATH= cd -- "$(dirname -- "$0")/.." && pwd)
runtime_dir=${XDG_RUNTIME_DIR:-"$repo/data/runtime"}
export XDG_RUNTIME_DIR="$runtime_dir"
exec /usr/bin/python3 -B "$repo/app/observer_say.py" "$@"
